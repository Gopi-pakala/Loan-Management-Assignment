{
 "doctype": "DocType",
 "name": "Loan Application",
 "module": "Loan Assignment",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "track_changes": 1,
 "autoname": "LA-.YYYY.-.#####",
 "naming_rule": "Expression (old style)",
 "sort_field": "modified",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {"fieldname": "section_break_applicant", "fieldtype": "Section Break", "label": "Applicant"},
  {"fieldname": "employee", "fieldtype": "Link", "label": "Employee", "options": "Employee", "reqd": 1, "in_standard_filter": 1},
  {"fieldname": "employee_name", "fieldtype": "Data", "label": "Employee Name", "fetch_from": "employee.employee_name", "read_only": 1},
  {"fieldname": "column_break_applicant", "fieldtype": "Column Break"},
  {"fieldname": "department", "fieldtype": "Link", "label": "Department", "options": "Department", "fetch_from": "employee.department", "read_only": 1, "in_standard_filter": 1},
  {"fieldname": "employee_grade", "fieldtype": "Link", "label": "Employee Grade", "options": "Employee Grade", "fetch_from": "employee.grade", "read_only": 1},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1, "fetch_from": "employee.company"},
  {"fieldname": "section_break_request", "fieldtype": "Section Break", "label": "Request"},
  {"fieldname": "loan_type", "fieldtype": "Link", "label": "Loan Type", "options": "Loan Type", "reqd": 1, "allow_on_submit": 1, "in_list_view": 1},
  {"fieldname": "requested_amount", "fieldtype": "Currency", "label": "Requested Amount", "reqd": 1, "allow_on_submit": 1, "options": "Company:company:default_currency", "in_list_view": 1},
  {"fieldname": "sanctioned_amount", "fieldtype": "Currency", "label": "Sanctioned Amount", "permlevel": 1, "allow_on_submit": 1, "options": "Company:company:default_currency"},
  {"fieldname": "column_break_request", "fieldtype": "Column Break"},
  {"fieldname": "tenure_months", "fieldtype": "Int", "label": "Tenure (Months)", "reqd": 1, "allow_on_submit": 1},
  {"fieldname": "first_deduction_month", "fieldtype": "Date", "label": "First Deduction Month", "reqd": 1, "allow_on_submit": 1},
  {"fieldname": "purpose", "fieldtype": "Small Text", "label": "Purpose", "allow_on_submit": 1},
  {"fieldname": "board_resolution_ref", "fieldtype": "Data", "label": "Board Resolution Reference", "allow_on_submit": 1},
  {"fieldname": "section_break_eligibility", "fieldtype": "Section Break", "label": "Eligibility"},
  {"fieldname": "monthly_gross", "fieldtype": "Currency", "label": "Monthly Gross (Snapshot)", "read_only": 1, "options": "Company:company:default_currency"},
  {"fieldname": "eligibility_status", "fieldtype": "Select", "label": "Eligibility Status", "options": "Not Checked\nEligible\nIneligible", "default": "Not Checked", "read_only": 1, "in_list_view": 1},
  {"fieldname": "column_break_eligibility", "fieldtype": "Column Break"},
  {"fieldname": "eligibility_notes", "fieldtype": "Small Text", "label": "Eligibility Notes", "read_only": 1},
  {"fieldname": "eligibility_override", "fieldtype": "Check", "label": "Eligibility Override", "allow_on_submit": 1},
  {"fieldname": "override_reason", "fieldtype": "Small Text", "label": "Override Reason", "allow_on_submit": 1, "mandatory_depends_on": "eval:doc.eligibility_override"},
  {"fieldname": "section_break_approval", "fieldtype": "Section Break", "label": "Approval"},
  {"fieldname": "action_comment", "fieldtype": "Small Text", "label": "Comment (for Reject / Return)", "allow_on_submit": 1, "no_copy": 1, "depends_on": "eval:doc.status=='Pending Approval'", "description": "Fill this in before clicking Reject or Return — required for both."},
  {"fieldname": "approval_rule", "fieldtype": "Link", "label": "Approval Rule", "options": "Loan Approval Rule", "read_only": 1, "allow_on_submit": 1},
  {"fieldname": "current_step", "fieldtype": "Int", "label": "Current Step", "read_only": 1, "default": "0", "allow_on_submit": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nPending Approval\nApproved\nRejected\nReturned", "default": "Draft", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1, "allow_on_submit": 1},
  {"fieldname": "column_break_approval", "fieldtype": "Column Break"},
  {"fieldname": "loan", "fieldtype": "Link", "label": "Loan", "options": "Loan", "read_only": 1, "allow_on_submit": 1},
  {"fieldname": "amended_from", "fieldtype": "Link", "label": "Amended From", "options": "Loan Application", "read_only": 1, "no_copy": 1, "print_hide": 1},
  {"fieldname": "section_break_log", "fieldtype": "Section Break", "label": "Approval History"},
  {"fieldname": "approval_log", "fieldtype": "Table", "label": "Approval Log", "options": "Loan Approval Log", "read_only": 1, "allow_on_submit": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "print": 1, "report": 1, "export": 1, "permlevel": 0},
  {"role": "System Manager", "read": 1, "write": 1, "permlevel": 1},
  {"role": "Employee", "read": 1, "write": 1, "create": 1, "submit": 1, "amend": 1, "print": 1, "permlevel": 0},
  {"role": "Reporting Manager", "read": 1, "write": 1, "print": 1, "report": 1, "permlevel": 0},
  {"role": "HR Manager", "read": 1, "write": 1, "print": 1, "report": 1, "export": 1, "permlevel": 0},
  {"role": "Finance Manager", "read": 1, "write": 1, "print": 1, "report": 1, "export": 1, "permlevel": 0},
  {"role": "Finance Manager", "read": 1, "write": 1, "permlevel": 1},
  {"role": "CFO", "read": 1, "write": 1, "print": 1, "report": 1, "export": 1, "permlevel": 0},
  {"role": "CFO", "read": 1, "write": 1, "permlevel": 1}
 ]
}
