{
 "doctype": "DocType",
 "name": "Loan Restructure Request",
 "module": "Loan Assignment",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "track_changes": 1,
 "autoname": "hash",
 "naming_rule": "Random",
 "sort_field": "modified",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {"fieldname": "loan", "fieldtype": "Link", "label": "Loan", "options": "Loan", "reqd": 1, "in_standard_filter": 1},
  {"fieldname": "request_type", "fieldtype": "Select", "label": "Request Type", "options": "Moratorium\nRe-tenure", "reqd": 1},
  {"fieldname": "effective_from", "fieldtype": "Date", "label": "Effective From", "reqd": 1, "description": "Periods before this date are untouchable"},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "moratorium_months", "fieldtype": "Int", "label": "Moratorium (Months)", "depends_on": "eval:doc.request_type=='Moratorium'"},
  {"fieldname": "new_tenure_months", "fieldtype": "Int", "label": "New Tenure (Months)", "depends_on": "eval:doc.request_type=='Re-tenure'"},
  {"fieldname": "reason", "fieldtype": "Small Text", "label": "Reason", "reqd": 1},
  {"fieldname": "section_break_state", "fieldtype": "Section Break", "label": "State"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nPending HR\nPending Finance\nApplied\nRejected", "default": "Draft", "read_only": 1, "in_list_view": 1},
  {"fieldname": "approval_log", "fieldtype": "Table", "label": "Approval Log", "options": "Loan Approval Log", "read_only": 1},
  {"fieldname": "amended_from", "fieldtype": "Link", "label": "Amended From", "options": "Loan Restructure Request", "read_only": 1, "no_copy": 1, "print_hide": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "print": 1, "report": 1, "export": 1},
  {"role": "Employee", "read": 1, "write": 1, "create": 1, "print": 1},
  {"role": "HR Manager", "read": 1, "write": 1, "print": 1, "report": 1},
  {"role": "Finance Manager", "read": 1, "write": 1, "submit": 1, "print": 1, "report": 1}
 ]
}
